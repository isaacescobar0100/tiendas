// Esquema de datos del e-commerce multi-tienda
// Roles: SUPERADMIN (plataforma) y ADMIN (dueño de una tienda)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
}

// Modelo de cobro de la tienda: venta única (del cliente) o renta (recurrente).
enum StorePlan {
  SALE
  RENT
}

// Estado de PAGO del pedido (SHIPPED queda en desuso; el envío va aparte).
enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

// Estado de ENVÍO del pedido (independiente del pago).
enum Fulfillment {
  PENDING
  SHIPPED
  DELIVERED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(ADMIN)
  // Anti fuerza bruta: intentos fallidos y bloqueo temporal de la cuenta.
  failedAttempts Int      @default(0)
  lockedUntil    DateTime?
  // Un ADMIN es dueño de (como máximo) una tienda. SUPERADMIN no tiene tienda.
  store        Store?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Store {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  customDomain String?   @unique // dominio propio (ej. yoswill.com) → mapea a esta tienda
  description String?
  logoUrl     String?
  bannerUrl   String?    // imagen de banner (portada) en la página de la tienda
  bannerVideoUrl String? // video de portada (hero) opcional; si está, reemplaza el banner
  surveyUrl   String?    // enlace a una encuesta de satisfacción (ej. Google Forms)
  whatsapp    String?    // número de WhatsApp de la tienda (para avisos de pedido)
  // Canales para avisar al cliente del estado del pedido (los elige el admin)
  notifyEmail    Boolean @default(true)
  notifyWhatsapp Boolean @default(false)
  themeColor  String     @default("#111827") // color de marca (botones/acentos)
  currency    String     @default("COP")
  active      Boolean    @default(true)
  // Métodos de pago que ofrece la tienda (los controla el superadmin)
  onlinePaymentEnabled Boolean @default(true) // "Ir a pagar en línea" (Wompi)
  codEnabled           Boolean @default(true) // contraentrega (pago al recibir)
  // Envío: costo fijo por pedido y umbral opcional de envío gratis (0 = desactivado)
  shippingCents        Int     @default(0)
  freeShippingOverCents Int    @default(0)
  // Llaves de Wompi POR TIENDA (las gestiona el superadmin). Si están vacías,
  // se usan las del entorno (.env) como respaldo para pruebas.
  wompiPublicKey       String?
  wompiPrivateKey      String?
  wompiIntegritySecret String?
  wompiEventsSecret    String?
  // Cobro: tipo de plan y (para renta) hasta cuándo está pagada.
  plan       StorePlan @default(SALE)
  paidUntil  DateTime?
  // Último aviso de renta enviado (ej. "soon:2026-08-09"); evita reenvíos diarios.
  rentNotice String?
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String     @unique
  categories  Category[]
  products    Product[]
  orders      Order[]
  customers   Customer[]
  promotions  Promotion[]
  slugAliases StoreSlugAlias[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Slugs antiguos de una tienda. Si alguien entra por uno, se redirige al actual.
model StoreSlugAlias {
  id        String   @id @default(cuid())
  slug      String   @unique
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId   String
  createdAt DateTime @default(now())

  @@index([storeId])
}

// Promoción del banner (slider). Cada una es una diapositiva de la portada.
model Promotion {
  id        String   @id @default(cuid())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId   String
  imageUrl  String?  // imagen de fondo de la diapositiva
  imagePosition String @default("50% 50%") // encuadre de la imagen (object-position)
  imageZoom     Float  @default(1)          // zoom de la imagen (1 = sin zoom)
  title     String?  // titular (p. ej. "50% en zapatillas")
  subtitle  String?  // texto secundario
  linkUrl   String?  // destino al hacer clic (ruta interna o URL)
  active    Boolean  @default(true)
  sortOrder Int      @default(0) // menor = aparece antes
  // Destinos donde se muestra la promoción (el admin los elige con casillas)
  showOnBanner Boolean @default(true)  // banner de inicio
  showOnOffers Boolean @default(false) // vista de Ofertas
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?  // si está, se muestra también en esa categoría
  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([categoryId])
}

// Cuenta de cliente de una tienda (para ver su historial de pedidos).
model Customer {
  id           String   @id @default(cuid())
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId      String
  email        String
  name         String
  passwordHash String
  // Anti fuerza bruta: intentos fallidos y bloqueo temporal de la cuenta.
  failedAttempts Int      @default(0)
  lockedUntil    DateTime?
  createdAt    DateTime @default(now())

  @@unique([storeId, email])
}

// Token para restablecer contraseña (admin o cliente). Se guarda solo el hash.
model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  kind       String    // "admin" | "customer"
  userId     String?   // si kind = admin
  customerId String?   // si kind = customer
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId   String
  products  Product[]
  promotions Promotion[]
  createdAt DateTime  @default(now())

  @@unique([storeId, slug])
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String
  description String?
  priceCents  Int       @default(0) // precio en céntimos para evitar errores de coma flotante
  salePriceCents Int?    // precio de oferta (en céntimos); si es menor al normal, hay descuento
  stock       Int       @default(0)
  imageUrl      String?   // imagen principal (portada)
  imagePosition String    @default("50% 50%") // punto focal de la portada (object-position)
  imageZoom     Float     @default(1) // zoom de la portada (1 = sin zoom)
  images        String[]  @default([]) // URLs de la galería (compat; ver galleryData)
  // Galería con encuadre por imagen: JSON [{url, position, zoom}]
  galleryData   String    @default("[]")
  active      Boolean   @default(true)
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId     String
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?
  variants    ProductVariant[]
  orderItems  OrderItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([categoryId])
}

// Variante de talla de un producto (con su propio stock)
model ProductVariant {
  id         String      @id @default(cuid())
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  // color y size vacíos ("") = dimensión no aplicable a este producto
  color      String      @default("")
  size       String      @default("")
  stock      Int         @default(0)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())

  @@unique([productId, color, size])
  @@index([productId])
}

model Order {
  id            String      @id @default(cuid())
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId       String
  customerName  String
  customerEmail String
  customerPhone String?
  // Dirección desglosada (los pedidos antiguos solo tienen `address`)
  // `street` guarda la dirección completa (ej. "Cra 23D # 45-12, Apto 301").
  street        String?
  streetNumber  String? // en desuso (se conserva por pedidos antiguos)
  neighborhood  String? // barrio
  city          String?
  postalCode    String?
  country       String?
  reference     String? // referencia / cómo llegar (ej. "casa blanca, portón negro")
  address       String // resumen legible de la dirección completa
  totalCents    Int // incluye el envío
  shippingCents Int         @default(0) // parte de envío del total
  currency      String      @default("COP")
  status        OrderStatus @default(PENDING) // estado de PAGO
  fulfillment   Fulfillment @default(PENDING) // estado de ENVÍO
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([storeId])
}

model OrderItem {
  id         String          @id @default(cuid())
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  // Referencia al producto (opcional: puede borrarse y el pedido se conserva)
  product    Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId  String?
  // Copia (snapshot) de los datos del producto en el momento de la compra
  name       String
  color      String?
  size       String?
  imageUrl   String?
  priceCents Int
  quantity   Int

  @@index([orderId])
}

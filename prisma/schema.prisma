// Esquema de datos del e-commerce multi-tienda
// Roles: SUPERADMIN (plataforma) y ADMIN (dueño de una tienda)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(ADMIN)
  // Un ADMIN es dueño de (como máximo) una tienda. SUPERADMIN no tiene tienda.
  store        Store?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Store {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  logoUrl     String?
  currency    String     @default("USD")
  active      Boolean    @default(true)
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String     @unique
  categories  Category[]
  products    Product[]
  orders      Order[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId   String
  products  Product[]
  createdAt DateTime  @default(now())

  @@unique([storeId, slug])
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String
  description String?
  priceCents  Int       @default(0) // precio en céntimos para evitar errores de coma flotante
  stock       Int       @default(0)
  imageUrl    String?   // imagen principal (portada)
  images      String[]  @default([]) // imágenes adicionales (galería)
  active      Boolean   @default(true)
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId     String
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?
  variants    ProductVariant[]
  orderItems  OrderItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([categoryId])
}

// Variante de talla de un producto (con su propio stock)
model ProductVariant {
  id         String      @id @default(cuid())
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  // color y size vacíos ("") = dimensión no aplicable a este producto
  color      String      @default("")
  size       String      @default("")
  stock      Int         @default(0)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())

  @@unique([productId, color, size])
  @@index([productId])
}

model Order {
  id            String      @id @default(cuid())
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId       String
  customerName  String
  customerEmail String
  customerPhone String?
  // Dirección desglosada (los pedidos antiguos solo tienen `address`)
  street        String?
  streetNumber  String?
  city          String?
  postalCode    String?
  country       String?
  address       String // resumen legible de la dirección completa
  totalCents    Int
  currency      String      @default("USD")
  status        OrderStatus @default(PENDING)
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([storeId])
}

model OrderItem {
  id         String          @id @default(cuid())
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  // Referencia al producto (opcional: puede borrarse y el pedido se conserva)
  product    Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId  String?
  // Copia (snapshot) de los datos del producto en el momento de la compra
  name       String
  color      String?
  size       String?
  imageUrl   String?
  priceCents Int
  quantity   Int

  @@index([orderId])
}

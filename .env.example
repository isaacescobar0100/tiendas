# Copia este archivo a .env y rellena los valores
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tienda?schema=public"
AUTH_SECRET="genera-uno-con: openssl rand -base64 32"
# AUTH_URL="http://localhost:3000"

# Emails de pedido por Gmail (opcional). Contraseña de aplicación de Google:
# https://myaccount.google.com/apppasswords (requiere Verificación en 2 pasos).
# GMAIL_USER="tucorreo@gmail.com"
# GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"

# Subida de imágenes en producción (Vercel Blob).
# En Vercel se inyecta sola al conectar un Blob Store; en local no hace falta.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# URL pública del sitio (para SEO y previews al compartir). En Vercel se detecta
# sola; ponla solo si usas un dominio propio. Ej: https://mitienda.com
# NEXT_PUBLIC_SITE_URL="https://mitienda.com"

# Pagos con Wompi (Colombia). Sin estas claves, el checkout solo registra el
# pedido (sin cobro online). Usa las de PRUEBA (pub_test_/prv_test_) primero.
# WOMPI_PUBLIC_KEY="pub_test_xxxxxxxx"
# WOMPI_PRIVATE_KEY="prv_test_xxxxxxxx"
# WOMPI_INTEGRITY_SECRET="test_integrity_xxxxxxxx"
# WOMPI_EVENTS_SECRET="test_events_xxxxxxxx"

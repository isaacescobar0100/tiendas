# Copia este archivo a .env y rellena los valores
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tienda?schema=public"
AUTH_SECRET="genera-uno-con: openssl rand -base64 32"
# AUTH_URL="http://localhost:3000"

# Emails de pedido (opcional) — https://resend.com
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="MiTienda <onboarding@resend.dev>"

# Subida de imágenes en producción (Vercel Blob).
# En Vercel se inyecta sola al conectar un Blob Store; en local no hace falta.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"
